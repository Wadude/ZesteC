rules_version = '2';

// Only members of a list can see or change it. People join with an invite code.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isMember(listId) {
      return request.auth.uid in listData(listId).memberIds;
    }

    function validItem() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.checked is bool
        && d.createdAt is number
        && d.get('order', 0) is number
        && d.get('quantity', 1) is number && d.get('quantity', 1) > 0
        && d.get('quantity', 1) <= 1000000
        && d.get('unit', 'pcs') in ['pcs', 'pack', 'g', 'kg', 'ml', 'L']
        && d.get('price', 0) is number && d.get('price', 0) >= 0
        && d.get('price', 0) <= 10000000
        && d.get('priceIsTotal', false) is bool;
    }

    // Name and photo, so members of a shared list can see who's who.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
    }

    // Invite codes. Readable one at a time by code (no listing), so they can't be browsed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.listId);
      allow delete: if signedIn() && isMember(resource.data.listId);
    }

    match /lists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // A new list starts with only its creator as member.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          // Members can rename the list or set its invite code, but not change who's in it.
          (request.auth.uid in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds)
          // The owner can remove people (but must stay in the list).
          || (request.auth.uid == resource.data.ownerId
            && request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds.hasAll(request.resource.data.memberIds))
          // Anyone else can leave.
          || (request.auth.uid in resource.data.memberIds
            && request.auth.uid != resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']))
          // Joining: add only yourself, with a valid invite code for this list.
          || (!(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinCode'])
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.listId == listId)
        );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /items/{itemId} {
        allow read, delete: if signedIn() && isMember(listId);
        allow create, update: if signedIn() && isMember(listId) && validItem();
      }
    }
  }
}
