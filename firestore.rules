rules_version = '2';

// Only members of a list can see or change it. People join with an invite code.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Private testing: valid tester codes. Change or add codes here, then deploy the rules.
    function testerCodes() {
      return ['ZESTE-JRDX'];
    }

    // The app owner, who can read the usage numbers on the stats screen.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'warren.pougnet@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Signed in AND let in to the private test.
    function allowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/testers/$(request.auth.uid));
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isMember(listId) {
      return request.auth.uid in listData(listId).memberIds;
    }

    function validItem() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.checked is bool
        && d.createdAt is number
        && d.get('order', 0) is number
        && d.get('quantity', 1) is number && d.get('quantity', 1) > 0
        && d.get('quantity', 1) <= 1000000
        && d.get('unit', 'pcs') in ['pcs', 'pack', 'g', 'kg', 'ml', 'L']
        && d.get('price', 0) is number && d.get('price', 0) >= 0
        && d.get('price', 0) <= 10000000
        && d.get('priceIsTotal', false) is bool
        && d.get('category', 'other') in ['produce', 'bakery', 'meat', 'dairy', 'frozen', 'pantry',
                                          'snacks', 'drinks', 'household', 'personal', 'other'];
    }

    function validTrip() {
      let d = request.resource.data;
      return d.total is number && d.total >= 0 && d.total <= 10000000
        && d.date is number
        && d.itemCount is number
        && d.items is list && d.items.size() <= 500
        && (!('store' in d) || (d.store is string && d.store.size() <= 60));
    }

    // Who's in the private test. Created with a tester code, or the code of a list invite
    // (so people invited to a shared list get in too). Can't be changed afterwards.
    match /testers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code is string
        && (request.resource.data.code in testerCodes()
          || exists(/databases/$(database)/documents/invites/$(request.resource.data.code)));
    }

    // Testers' feedback: write-only from the app, read in the Firebase console.
    match /feedback/{id} {
      // People can find and delete their own feedback (account deletion); the owner reads it all.
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if allowed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.kind in ['problem', 'idea', 'other'];
    }

    // Name and photo, so members of a shared list can see who's who.
    match /users/{uid} {
      allow read: if allowed();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if allowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
    }

    // Usage numbers: one document per person per day with simple counts (no content).
    // Written only by that person; read only by the app owner (and the person, to delete it).
    match /usage/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if allowed()
        && docId.matches(request.auth.uid + '_[0-9-]+')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'day', 'opens', 'itemsAdded', 'shops', 'invitesSent', 'joined', 'lang', 'appVersion']);
    }

    // Invite codes. Readable one at a time by code (no listing), so they can't be browsed.
    match /invites/{code} {
      allow get: if allowed();
      allow create: if allowed()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.listId);
      allow delete: if allowed() && isMember(resource.data.listId);
    }

    match /lists/{listId} {
      allow read: if (allowed() && request.auth.uid in resource.data.memberIds) || isAdmin();

      // A new list starts with only its creator as member.
      allow create: if allowed()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow update: if allowed()
        && (
          // Members can rename the list, set its invite code or budget, but not change who's in it.
          (request.auth.uid in resource.data.memberIds
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.get('monthlyBudget', 0) is number
            && request.resource.data.get('monthlyBudget', 0) >= 0
            && request.resource.data.get('monthlyBudget', 0) <= 100000000)
          // The owner can remove people (but must stay in the list).
          || (request.auth.uid == resource.data.ownerId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds.hasAll(request.resource.data.memberIds))
          // The owner can hand the list to another member and leave (used when deleting an account).
          || (request.auth.uid == resource.data.ownerId
            && request.resource.data.ownerId != request.auth.uid
            && request.resource.data.ownerId in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'memberIds']))
          // Anyone else can leave.
          || (request.auth.uid in resource.data.memberIds
            && request.auth.uid != resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']))
          // Joining: add only yourself, with a valid invite code for this list.
          || (!(request.auth.uid in resource.data.memberIds)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinCode'])
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.listId == listId)
        );

      allow delete: if allowed() && resource.data.ownerId == request.auth.uid;

      match /items/{itemId} {
        allow read, delete: if allowed() && isMember(listId);
        allow create, update: if allowed() && isMember(listId) && validItem();
      }

      // Shops (trips) for the budget.
      match /trips/{tripId} {
        allow read, delete: if allowed() && isMember(listId);
        allow create: if allowed() && isMember(listId) && validTrip()
          && request.resource.data.enteredBy == request.auth.uid;
        allow update: if allowed() && isMember(listId) && validTrip()
          && request.resource.data.enteredBy == resource.data.enteredBy;
      }
    }
  }
}
